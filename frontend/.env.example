# Backend base URL. Leave unset to run on the built-in mock data store.
VITE_API_URL=

# Generate the "Apex Academy" demo tenant on first run.
#   unset  → follows VITE_API_URL: demo data with no backend, none with one (default)
#   true   → always seed the demo tenant (sales demos, UI review, screenshots)
#   false  → start from an EMPTY institute: the two built-in roles, the owner's
#            staff record and nothing else, so the owner is taken through the
#            first-run setup wizard at /setup — this is what a real client gets.
# A client's instance must never ship demo data (see docs/HOSTING.md).
VITE_DEMO_DATA=
