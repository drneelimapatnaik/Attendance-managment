# ---------------------------------------------------------------------------
# EduTrack API — environment template. Copy to `.env` and fill in real values.
# Every variable below is validated at boot (src/config/env.validation.ts); the
# process exits immediately if a required one is missing or malformed.
# NEVER commit a real .env — this file holds placeholders only.
# ---------------------------------------------------------------------------

# Runtime ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (the Vite dev server, your web app).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Public base URL of this API, used when building links in emails.
APP_URL=http://localhost:3000
# Public base URL of the web app, used for activation / password-reset links.
WEB_APP_URL=http://localhost:5173

# Database --------------------------------------------------------------------
# The ONE database this instance serves. One client = one deployment = one database
# (docs/HOSTING.md), so on a client's instance this is their database and nothing
# else is reachable from it.
# Matches docker-compose.yml. Change the credentials for anything beyond local dev.
DATABASE_URL=postgresql://edutrack:edutrack@localhost:5432/edutrack?schema=public

# Operations (the CLIs in scripts/ only — the API never reads any of these) --------
# See docs/OPERATIONS.md. None of this is needed to run the API.
#
# Administrator connection used by `client:create` / `client:drop` to CREATE and DROP
# databases and roles. Point it at a maintenance database (usually `postgres`) with a
# role that has CREATEDB and CREATEROLE. NEVER give this to a client instance.
ADMIN_DATABASE_URL=postgresql://edutrack:edutrack@localhost:5432/postgres?schema=public
# The client registry: a JSON file listing every client database. Operator state, not
# application state — git-ignored, chmod 600, and backed up separately.
CLIENT_REGISTRY_PATH=./ops/clients.json
# Prefix for generated database names: APEX → edutrack_apex, role edutrack_apex_app.
CLIENT_DB_PREFIX=edutrack_
# Host/port to put in the connection string handed to a client instance, when the
# instance reaches the server by a different name than this CLI does (e.g. the CLI
# runs on the host at localhost:5432 while the app runs in Docker and sees `db:5432`).
# Unset = reuse the host and port from ADMIN_DATABASE_URL.
# CLIENT_DB_HOST=db
# CLIENT_DB_PORT=5432
# Where `client:drop` writes its pg_dump backup before dropping anything.
BACKUP_DIR=./ops/backups
# pg_dump: either a binary on PATH, or the name of a Docker container to run it in
# (useful on a machine with no Postgres client tools, where the server is in Docker).
# PG_DUMP_BIN=pg_dump
# PG_TOOLS_DOCKER_CONTAINER=edutrack-db
#
# Per-client connection strings, when the registry file does not store them
# (`client:create --secrets env`). One variable per client, named after its code:
# CLIENT_DB_URL_APEX=postgresql://edutrack_apex_app:...@db:5432/edutrack_apex?schema=public

# Auth ------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars
# Access token lifetime (ms/vercel duration string). Refresh lifetime in days.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=edutrack-api
JWT_AUDIENCE=edutrack-app

# One-time codes (parent OTP) and single-use email links ------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
# Activation / password-reset link lifetime.
RESET_TOKEN_TTL_MINUTES=60
ACTIVATION_TOKEN_TTL_HOURS=168

# Rate limiting (applies to every route; auth routes tighten it further) --------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Docs ------------------------------------------------------------------------
# Swagger is served at /docs. Leave this unset and it is ON outside production and
# OFF in production; set it explicitly to override either way.
SWAGGER_ENABLED=true

# Seed credentials (used by `npm run db:seed` only) -----------------------------
SEED_TENANT_CODE=APEX
SEED_STAFF_PASSWORD=Apex@2026
SEED_STUDENT_PASSWORD=student123
SEED_PARENT_PASSWORD=parent123
