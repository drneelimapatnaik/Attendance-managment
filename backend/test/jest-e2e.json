{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }] },
  "moduleNameMapper": { "^@/(.*)$": "<rootDir>/src/$1" },
  "globalSetup": "<rootDir>/test/e2e-global-setup.ts",
  "testTimeout": 30000
}
